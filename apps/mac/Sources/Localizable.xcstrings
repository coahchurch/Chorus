{
  "sourceLanguage" : "en",
  "strings" : {
    "Add a second language" : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இரண்டாவது மொழியைச் சேர்"
          }
        }
      }
    },
    "Add transliteration" : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "எழுத்துப்பெயர்ப்பைச் சேர்"
          }
        }
      }
    },
    "Appearance" : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தோற்றம்"
          }
        }
      }
    },
    "Audience" : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பார்வையாளர்கள்"
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ரத்து செய்"
          }
        }
      }
    },
    "Chords" : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஸ்வரங்கள்"
          }
        }
      }
    },
    "Choose English or Tamil for the app interface." : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பயன்பாட்டு இடைமுகத்திற்காக ஆங்கிலம் அல்லது தமிழைத் தேர்ந்தெடுக்கவும்."
          }
        }
      }
    },
    "English" : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஆங்கிலம்"
          }
        }
      }
    },
    "General" : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பொது"
          }
        }
      }
    },
    "From" : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இதிலிருந்து"
          }
        }
      }
    },
    "Generate" : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உருவாக்கு"
          }
        }
      }
    },
    "Generate it, then edit as needed—or enter it yourself." : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உருவாக்கிய பிறகு தேவைக்கேற்ப திருத்தவும்; அல்லது நீங்களே உள்ளிடவும்."
          }
        }
      }
    },
    "Import" : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இறக்குமதி செய்"
          }
        }
      }
    },
    "Import Lyrics" : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பாடல் வரிகளை இறக்குமதி செய்"
          }
        }
      }
    },
    "Language lines must match the primary lyrics." : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மற்ற மொழி வரிகள் முதன்மை வரிகளுடன் எண்ணிக்கையில் பொருந்த வேண்டும்."
          }
        }
      }
    },
    "Detected: SongSelect lyrics — CCLI number will be stamped" : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SongSelect பாடல் வரிகள் கண்டறியப்பட்டன — CCLI எண் சேர்க்கப்படும்"
          }
        }
      }
    },
    "Detected: ChordPro — chords stripped for slides, kept for charts" : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChordPro கண்டறியப்பட்டது — ஸ்லைடுகளில் ஸ்வரங்கள் நீக்கப்படும்; சார்ட்டில் இருக்கும்"
          }
        }
      }
    },
    "Detected: chord chart — chords above the words become the song's chords" : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஸ்வர சார்ட் கண்டறியப்பட்டது — சொற்களுக்கு மேலுள்ள ஸ்வரங்கள் பாடலின் ஸ்வரங்களாகும்"
          }
        }
      }
    },
    "Plain text — blank lines split slides, labels make sections" : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "எளிய உரை — காலி வரிகள் ஸ்லைடுகளைப் பிரிக்கும்; தலைப்புகள் பகுதிகளை உருவாக்கும்"
          }
        }
      }
    },
    "Language" : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மொழி"
          }
        }
      }
    },
    "Light" : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
