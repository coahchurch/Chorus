        }
      }
    },
    "One scheme across Present and Edit." : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நிகழ்த்தல் மற்றும் திருத்தம் ஆகிய இரண்டிலும் ஒரே நிறத் தோற்றம்."
          }
        }
      }
    },
    "Dark is the booth default." : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கட்டுப்பாட்டு அறைக்கான இயல்புநிலை இருண்ட தோற்றம்."
          }
        }
      }
    },
    "The slides appear here as you type." : {
      "localizations" : {
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் தட்டச்சு செய்யும் போது ஸ்லைடுகள் இங்கே தோன்றும்."
          }
        }
      }
    },
